{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Obvious Intel",
  "version": "0.1.0",
  "identifier": "ai.obvious.intel.compat",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Obvious",
        "url": "https://app.obvious.ai",
        "width": 1440,
        "height": 920,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "devtools": true
      }
    ],
    "security": {
      "capabilities": ["obvious-remote"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "entitlements": "./Entitlements.plist"
    }
  }
}
